     }
     if extra == 0 {
         // Single byte: 0xxxxxxx
+        crate::msx_trace::vint(&input[..1]);
         return Ok((first as u64, 1));
     }
     // Load the `extra` continuation bytes as the low bits of a u64 via ONE
@@ -69,6 +70,7 @@ pub fn decode_unsigned(input: &[u8]) -> Result<(u64, usize), VIntError> {
         // shift overflow.
         ((first as u64 & mask) << (extra * 8)) | tail
     };
+    crate::msx_trace::vint(&input[..total]);
     Ok((value, total))
